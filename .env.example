# Copy to .env and fill in. .env is gitignored.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5433/tpbook
STOCKROOM_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5433/stockroom
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5433/postgres
# Optional TLS server (docker compose up -d): see docker-compose.yml
TLS_PG_PASSWORD=CHANGE_ME
TLS_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5434/tpbook?sslmode=require
TLS_CA_FILE=docker/certs/ca.crt
